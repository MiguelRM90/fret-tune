{
  "name": "fret-tune",
  "version": "1.0.0",
  "description": "Precision chromatic tuner PWA for guitar, bass and ukulele",
  "author": "MiguelRM90",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "ng": "ng",
    "build:worklets": "esbuild src/app/core/workers/capture.worklet.ts --outfile=public/worklets/capture.worklet.js --bundle --format=esm --target=es2022 --log-level=warning",
    "start": "esbuild src/app/core/workers/capture.worklet.ts --outfile=public/worklets/capture.worklet.js --bundle --format=esm --target=es2022 --log-level=warning && ng serve",
    "build": "esbuild src/app/core/workers/capture.worklet.ts --outfile=public/worklets/capture.worklet.js --bundle --format=esm --target=es2022 --log-level=warning && ng build --configuration production && node scripts/verify-security-and-pwa.mjs --all",
    "build:gh-pages": "esbuild src/app/core/workers/capture.worklet.ts --outfile=public/worklets/capture.worklet.js --bundle --format=esm --target=es2022 --log-level=warning && ng build --configuration production --base-href /fret-tune/ && node scripts/verify-security-and-pwa.mjs --all",
    "watch": "esbuild src/app/core/workers/capture.worklet.ts --outfile=public/worklets/capture.worklet.js --bundle --format=esm --target=es2022 --log-level=warning && ng build --watch --configuration development",
    "verify:security": "node scripts/verify-security-and-pwa.mjs",
    "verify:pwa": "node scripts/verify-security-and-pwa.mjs --all",
    "test": "node scripts/verify-security-and-pwa.mjs && esbuild \"src/**/*.spec.ts\" --outdir=dist/test-dist --bundle --platform=node --format=esm --packages=external --out-extension:.js=.mjs --log-level=warning && node --test \"dist/test-dist/**/*.spec.mjs\"",
    "bench": "esbuild \"src/**/*.bench.ts\" --outdir=dist/bench-dist --bundle --platform=node --format=esm --packages=external --out-extension:.js=.mjs --log-level=warning && node \"dist/bench-dist/app/core/dsp/mcleod-pitch-detector.bench.mjs\""
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "pwa-ui-core": "file:../pwa-ui-core",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~6.0.2"
  }
}
